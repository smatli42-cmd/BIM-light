{
  "name": "bim-light",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @bim-light/sandbox",
    "build": "npm run build -w @bim-light/sandbox",
    "preview": "npm run preview -w @bim-light/sandbox",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/ifc --noEmit && tsc -p apps/sandbox --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c apps/sandbox/playwright.config.ts",
    "check:size": "node tools/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:size && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
